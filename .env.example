# QUIZVERSE — environment variables (copy to .env or set in your host's dashboard)
#
# Nothing here is required to run the game. Everything has a safe default.

# ---------- server ----------
HOST=0.0.0.0                 # 0.0.0.0 lets phones/tablets on the same Wi-Fi join
PORT=4317

# Signs teacher login tokens. SET THIS IN PRODUCTION, otherwise every restart
# logs teachers out.
QV_API_SECRET=change-me-to-a-long-random-string

# ---------- storage ----------
QV_STORAGE=file              # file | memory | postgres
QV_DATA_DIR=./.data          # used by the file store
# QV_DATABASE_URL=postgres://user:pass@host:5432/quizverse   # used by QV_STORAGE=postgres

# ---------- live AI generation (optional) ----------
# Without a key the app uses the offline demo library + the answers inside your
# own material. With a key any class and any topic can be generated live.
# QV_AI_PROVIDER=openai      # openai | anthropic | gemini | ollama | mock
# QV_AI_KEY=sk-...
# QV_AI_MODEL=gpt-4o-mini
# QV_AI_BASE_URL=https://api.openai.com/v1
#
# Provider-specific keys are also accepted:
# QV_OPENAI_KEY=
# QV_ANTHROPIC_KEY=
# QV_GEMINI_KEY=
